# === JWT Authentication ===
JWT_SECRET_KEY=ai-nexus-rag-engine-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# === OpenRouter (LLM) ===
OPENROUTER_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free
VISION_LLM_MODEL=google/gemma-4-31b-it:free
SUMMARY_MODEL=inclusionai/ling-3.0-flash:free
DEFAULT_MODEL=google/gemma-4-31b-it:free
APP_URL=http://localhost:8000

# === Embeddings & Reranking ===
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODE=local
HF_API_TOKEN=
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-2-v2

# === Storage Paths ===
CHROMA_DB_PATH=./data/chroma_db
PARENT_STORE_PATH=./data/parent_store.sqlite
LONG_TERM_DB_PATH=./data/memory.sqlite
IMAGE_CACHE_DB_PATH=./data/image_cache.sqlite
USERS_DB_PATH=./data/users.sqlite
CHAT_HISTORY_DB_PATH=./data/chat_history.sqlite
UPLOAD_DIR=./data/uploads
IMAGE_DIR=./data/images

# === Upload Limits ===
MAX_UPLOAD_SIZE_MB=50

# === Retrieval & 3-Way Gate Thresholds ===
RERANK_PASS_THRESHOLD=0.0
RERANK_CLARIFY_THRESHOLD=-2.0
RETRIEVAL_K=15
TOP_N_SYNTHESIS=5

# === Memory ===
SUMMARY_TRIGGER=20
KEEP_RECENT=6

# === LangSmith (Monitoring) ===
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-nexus-rag-engine
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# === Server ===
CORS_ORIGINS=["http://localhost:5173"]
